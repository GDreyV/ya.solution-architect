@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam dpi 150
skinparam wrapWidth 180
skinparam maxMessageSize 45
    title Оцифровка кредитных документов
    Person(client, "Клиент", "Предоставляет кредитный пакет")
    Person(underwriter, "Андеррайтер", "Проверяет исключения и контрольную выборку")
    System_Boundary(bank, "Контур банка") {
        System_Ext(credit, "Кредитный процесс", "Приём пакета и работа с заявкой")
        System_Boundary(ocrSystem, "Оцифровка") {
            Container(ocr, "Обработчик документов", "Обычный код и локальное распознавание", "Проверяет файл, читает текстовый слой либо распознаёт страницы")
            ContainerDb(docs, "Документы и результаты", "Хранилище", "Оригиналы, текстовые блоки, координаты и статус обработки")
            Container(review, "Просмотр и исправление", "Внутреннее приложение", "Показывает проблемные области и оригинал; поддерживает выборочный контроль")
        }
    }
    Rel(client, credit, "D1: недоверенный документ")
    Rel(credit, docs, "D2: оригинал и связь с заявкой")
    Rel(credit, ocr, "Поставить документ на асинхронную обработку")
    Rel(ocr, docs, "Читает оригинал; сохраняет проверенную структуру черновика")
    Rel(review, docs, "D2: читает оригинал и текст; сохраняет исправления")
    Rel(underwriter, review, "Исправляет исключения; проверяет выборку", "Ролевой доступ")
    Rel(review, credit, "Статус ручной проверки документа")


@enduml
