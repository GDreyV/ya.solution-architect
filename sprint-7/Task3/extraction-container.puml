@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam dpi 150
skinparam wrapWidth 180
skinparam maxMessageSize 45
    title Извлечение финансовых показателей
    Person(underwriter, "Андеррайтер", "Подтверждает значения перед записью в заявку")
    System_Boundary(bank, "Контур банка") {
        System_Ext(credit, "Кредитный процесс", "Хранит подтверждённые поля заявки")
        System_Ext(ocr, "Оцифровка — инициатива 2", "Текст сканов и координаты; общий компонент")
        ContainerDb(docs, "Документы и результаты", "Общее хранилище", "Оригиналы, таблицы, распознанные блоки")
        System_Boundary(extractSystem, "Извлечение показателей") {
            Container(extract, "Извлечение и проверка", "Обычный код и локальная модель", "Читает таблицы или текст; извлекает поля; проверяет схему, периоды и единицы")
            ContainerDb(draft, "Черновики показателей", "Хранилище", "Значения, источники, противоречия, версии и подтверждения")
            Container(review, "Проверка показателей", "Внутреннее приложение", "Показывает поле и область оригинала; принимает подтверждение")
        }
    }
    Rel(credit, extract, "Запрос асинхронной обработки документа")
    Rel(docs, extract, "D2: содержимое только текущего документа")
    Rel(ocr, extract, "Текст и координаты для сканов")
    Rel(extract, draft, "D3: результат модели после детерминированных проверок")
    Rel(extract, ocr, "Результаты проверок: проблемные области текста")
    Rel(review, draft, "Чтение черновика; исправление и подтверждение")
    Rel(review, docs, "D2: открытие области оригинала")
    Rel(underwriter, review, "Сверка значения, периода, единицы и организации")
    Rel(review, credit, "D4: запись только подтверждённых полей")


@enduml
