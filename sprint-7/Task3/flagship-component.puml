@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam dpi 150
skinparam wrapWidth 180
skinparam maxMessageSize 45
    title Компоненты приложения оценки операций
    Container_Ext(source, "Источники операций", "Банковские источники", "История, текущие операции, сигналы правил")
    ContainerDb_Ext(store, "Данные сервиса", "Хранилище", "Очередь, результаты, экспертные оценки")
    Container_Ext(audit, "Мониторинг и аудит", "Внутренний сервис", "Ошибки и длительность обработки")
    Container_Boundary(rank, "Оценка операции и расчёт приоритета") {
        Component(load, "Получение данных", "Обычный код", "Чтение на момент расчёта; проверка полноты и актуальности")
        Component(sample, "Независимая контрольная выборка", "Обычный код", "Вероятностный отбор всего потока; сохранение вероятности включения")
        Component(features, "Подготовка истории", "Обычный код", "Предыдущая история клиента без текущей операции; проверка пригодности")
        Component(model, "Оценка необычности", "Локальная модель", "Возвращает оценку для ранжирования; не выносит вердикт")
        Component(validate, "Проверка ответа", "Обычный код", "Схема, идентификаторы, версия, конечное число, источники")
        Component(queue, "Правила очереди", "Обычный код", "Обязательный приоритет, бюджет труда, резервный порядок и защита от бесконечного ожидания")
    }
    Rel(source, load, "G1: разрешённые поля и время их доступности")
    Rel(load, sample, "Доступный поток для независимого отбора")
    Rel(load, features, "Помеченные операции и история")
    Rel(features, model, "Пригодные данные")
    Rel(model, validate, "G4: недоверенный результат модели")
    Rel(features, queue, "Непригодные данные: резервный маршрут")
    Rel(validate, queue, "Проверенная оценка либо ошибка")
    Rel(load, queue, "Сигналы обязательного контроля")
    Rel(sample, queue, "Контрольные операции с вероятностью включения")
    Rel(queue, store, "Обновление очереди и версии результата")
    Rel(queue, audit, "G3: счётчики, резервные маршруты и задержки")


@enduml
