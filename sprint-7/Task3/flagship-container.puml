@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam dpi 150
skinparam wrapWidth 180
skinparam maxMessageSize 45
    title Приоритизация ручной проверки — контейнеры
    Person(analyst, "Сотрудник финансового мониторинга", "Проверяет операцию и фиксирует решение")
    System_Boundary(bank, "Контур банка") {
        System_Ext(source, "Источники операций и истории", "Банковские данные; чтение по согласованным правам")
        System_Ext(rules, "Действующий контроль", "Пороговые правила, внешние сигналы и обязательные проверки")
        System_Boundary(service, "Сервис приоритизации") {
            Container(rank, "Оценка операции и расчёт приоритета", "Приложение и локальная модель", "Готовит данные; оценивает необычность; проверяет ответ")
            ContainerDb(store, "Данные сервиса", "Хранилище", "Очередь, результаты, версии, экспертные оценки и способ отбора")
            Container(ui, "Рабочий интерфейс проверки", "Внутреннее приложение", "Выдаёт операции с источниками; принимает решение сотрудника")
        }
        System_Ext(audit, "Мониторинг и аудит", "Ошибки, задержки, доступы и состояние очереди")
    }
    Rel(source, rank, "G1: помеченные операции, история; вероятностная выборка всего потока", "События и чтение по запросу")
    Rel(rules, rank, "G1: сигналы и обязательные приоритеты", "События и чтение по запросу")
    Rel(rank, store, "Проверенные результаты и очередь; отдельная контрольная выборка")
    Rel(rules, store, "Исходная очередь и обязательные проверки — независимо от модели")
    Rel(ui, store, "Читает очередь; записывает решение и экспертную оценку")
    Rel(analyst, ui, "G2: просмотр источника, проверка и подтверждение", "Ролевой доступ")
    Rel(ui, source, "G1: открывает исходную операцию по ссылке")
    Rel(rank, audit, "G3: события обработки без полного содержимого операции")
    Rel(ui, audit, "G3: действия сотрудника и ошибки доступа")


@enduml
