@startuml
!include <C4/C4_Context>
LAYOUT_LEFT_RIGHT()
AddRelTag("future", $lineStyle=DashedLine(), $textColor="#777777", $lineColor="#999999")
title Africa Delivery — C4 Context\nMVP: Нигерия; пунктир: будущие или альтернативные интеграции
Person(buyer, "Покупатель", "Находит товар, оплачивает, получает заказ")
Person(seller, "Продавец", "Размещает товары, исполняет заказы, получает выплаты")
Person(ops, "Оператор поддержки", "Проверяет продавцов, разбирает возвраты и расхождения")
System(platform, "Africa Delivery", "Маркетплейс: каталог, заказы, учёт платежей, доставка, поддержка")
System_Ext(paystack, "Paystack", "Кандидат на платёжного партнёра Нигерии; договор не заключён")
System_Ext(flutterwave, "Flutterwave", "Альтернатива; подключение после оценки условий")
System_Ext(mpesa, "M-Pesa", "Будущий рынок Кении; вне MVP")
System_Ext(sendbox, "Sendbox", "Кандидат на логистического партнёра; покрытие требует пилота")
System_Ext(sendy, "Sendy", "Из исходных материалов; доступность и контрагент не подтверждены, вне MVP")
System_Ext(wa, "WhatsApp Business API", "Транзакционные сообщения по допустимому основанию")
System_Ext(sms, "SMS/USSD-шлюз", "SMS в MVP; USSD отложен")
Rel(buyer, platform, "Просматривает каталог, оформляет заказ и возврат", "HTTPS")
Rel(seller, platform, "Управляет товарами и заказами, проверяет выплаты", "HTTPS")
Rel(ops, platform, "Проводит проверки, сверку и возвраты", "HTTPS / MFA")
Rel(platform, paystack, "Создаёт платёж, запрашивает возврат и выплату", "API / HTTPS")
Rel(paystack, platform, "Передаёт результаты операций", "Подписанный webhook")
Rel(platform, sendbox, "Создаёт отправление, получает статус", "API / HTTPS")
Rel(platform, wa, "Отправляет подтверждения и статусы заказа", "API / HTTPS")
Rel(platform, sms, "Отправляет OTP и статусы; USSD позднее", "API / HTTPS")
Rel(platform, flutterwave, "Альтернативный приём платежей после отдельного решения", "API / HTTPS", $tags="future")
Rel(platform, mpesa, "Приём mobile money после выхода в Кению", "API / HTTPS", $tags="future")
Rel(platform, sendy, "Будущая доставка при подтверждении контрагента", "API / HTTPS", $tags="future")
SHOW_LEGEND()
@enduml
