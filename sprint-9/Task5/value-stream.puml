@startuml
title Поток ценности MVP
start
:Проверенный продавец публикует товар\n[Доверие; ассортимент];
:Покупатель находит товар\n[Выбор; клиентский канал];
:Оформляет заказ\n[Заказы; наличие; согласия];
:Оплачивает через партнёра\n[Расчёты];
if (Оплата подтверждена?) then (да)
  :Заказ передаётся перевозчику\n[Исполнение];
  :Покупатель получает статус и товар\n[Уведомления; исполнение];
  :Сверка и выплата продавцу\n[Расчёты];
  if (Возврат?) then (да)
    :Поддержка проверяет обращение\n[Доверие; споры];
    :Партнёр выполняет возврат\n[Расчёты];
  endif
else (нет)
  :Сверка pending или корректный отказ\n[Расчёты; поддержка];
endif
stop
@enduml
